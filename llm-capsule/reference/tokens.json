{
  "brand": "llm-capsule",
  "version": "6.1",
  "description": "LLM Capsule Design Tokens — Single Source of Truth",

  "color": {
    "bg":           { "value": "#ffffff",  "css": "--c-bg",           "desc": "Background white" },
    "bg-soft":      { "value": "#f7f8fb",  "css": "--c-bg-soft",      "desc": "Surface light / soft background" },
    "bg-dark":      { "value": "#0f1130",  "css": "--c-bg-dark",      "desc": "Dark section background" },
    "bg-dark-2":    { "value": "#1b1d4a",  "css": "--c-bg-dark-2",    "desc": "Dark card background" },
    "ink":          { "value": "#0f1130",  "css": "--c-ink",          "desc": "Text primary (navy)" },
    "ink-soft":     { "value": "#3a3d5e",  "css": "--c-ink-soft",     "desc": "Text secondary" },
    "muted":        { "value": "#6b7280",  "css": "--c-muted",        "desc": "Text tertiary / muted" },
    "rule":         { "value": "#e5e7eb",  "css": "--c-rule",         "desc": "Border / divider" },

    "primary":      { "value": "#5b4fe9",  "css": "--c-primary",      "desc": "Brand purple — CTA, accents" },
    "primary-dark": { "value": "#3b2fbf",  "css": "--c-primary-dark", "desc": "Purple dark — hover" },
    "primary-soft": { "value": "#eeebfe",  "css": "--c-primary-soft", "desc": "Purple tint — badge/banner bg" },

    "teal":         { "value": "#0ea5a4",  "css": "--c-teal",         "desc": "Teal — differentiator accent" },
    "teal-dark":    { "value": "#0b7f7e",  "css": "--c-teal-dark",    "desc": "Teal dark" },
    "teal-soft":    { "value": "#e6f7f6",  "css": "--c-teal-soft",    "desc": "Teal tint" },

    "coral":        { "value": "#ef5350",  "css": "--c-coral",        "desc": "Coral — problem/warning" },
    "coral-dark":   { "value": "#c73e3a",  "css": "--c-coral-dark",   "desc": "Coral dark" },
    "coral-soft":   { "value": "#fce9e8",  "css": "--c-coral-soft",   "desc": "Coral tint" },

    "amber":        { "value": "#f59e0b",  "css": "--c-amber",        "desc": "Amber — caution" },
    "amber-dark":   { "value": "#b7790c",  "css": "--c-amber-dark",   "desc": "Amber dark" },
    "amber-soft":   { "value": "#fef3c7",  "css": "--c-amber-soft",   "desc": "Amber tint" }
  },

  "font": {
    "display": { "value": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif", "css": "--f-display", "desc": "Base display font" },
    "mono":    { "value": "'JetBrains Mono', 'SF Mono', 'Consolas', monospace",                "css": "--f-mono",    "desc": "Code / mono font" }
  },

  "spacing": {
    "page":    { "value": "clamp(20px, 4vw, 80px)",    "css": "--s-page",    "desc": "Container padding" },
    "section": { "value": "clamp(64px, 8vw, 128px)",   "css": "--s-section", "desc": "Section vertical padding" }
  },

  "radius": {
    "sm": { "value": "6px",  "css": "--r-sm", "desc": "Small radius" },
    "md": { "value": "10px", "css": "--r-md", "desc": "Medium radius (cards, buttons)" },
    "lg": { "value": "16px", "css": "--r-lg", "desc": "Large radius (sections, hero)" }
  },

  "container": {
    "max-width": { "value": "1280px", "css": "--container-max", "desc": "Container max width" }
  },

  "typography": {
    "h1": { "size": "clamp(36px, 5vw, 64px)",   "weight": 700, "leading": 1.15, "tracking": "-0.02em" },
    "h2": { "size": "clamp(28px, 3.5vw, 44px)", "weight": 700, "leading": 1.15, "tracking": "-0.02em" },
    "h3": { "size": "clamp(18px, 1.6vw, 22px)", "weight": 700, "leading": 1.15, "tracking": "-0.02em" },
    "h4": { "size": "16px",                      "weight": 700, "leading": 1.15, "tracking": "-0.02em" },
    "body": { "leading": 1.55 }
  }
}
